# Exclude all files by default
*

# Include only GitHub Pages files
!index.html
!manifest.json
!form.html
!boundary-maps.html
!pipeline.html
!sheets.html

# Tab icons (favicons) for the Pages sites
!icon-*.svg
!icon-*.png
!maps/
!maps/*
!.gitignore

# --- never commit credentials (both repos) ---
.env
.env.*
*.env
supabase/.env
supabase/.secrets*

# exported spreadsheet data — PII, never commit
supabase/import/*.xlsx
supabase/import/*.csv
